# e-Notary BPRS — Root Environment Example (untuk docker-compose / lokal)
# Salin menjadi .env di root bila memakai docker-compose.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bprs_enotary
POSTGRES_PORT=5432

# Sama dengan backend/.env.example
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=bprs_enotary
DB_SSLMODE=disable
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
JWT_SECRET=change-me-min-32-chars-secret-key
JWT_EXPIRY=24h
