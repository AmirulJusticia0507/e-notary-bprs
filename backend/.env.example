# e-Notary BPRS — Backend Environment Example
# Salin menjadi .env:  cp .env.example .env

# Database PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=bprs_enotary
DB_SSLMODE=disable

# Server HTTP (Gin)
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# JWT Auth
JWT_SECRET=change-me-min-32-chars-secret-key
JWT_EXPIRY=24h

# Integrasi opsional (stub bila kosong)
EMETERAI_BASE_URL=
EMETERAI_API_KEY=
ESIGN_BASE_URL=
ESIGN_API_KEY=
PDF_TEMPLATE_PATH=./templates
