# e-Notary BPRS — Backend Environment Example
# Salin menjadi .env:  cp .env.example .env

# Database PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=bprs_enotary
DB_SSLMODE=disable
# Untuk Vercel/Neon, isi DATABASE_URL di environment Vercel.
DATABASE_URL=

# Server HTTP (Gin)
# Vercel mengisi PORT secara otomatis; nilai ini untuk lokal.
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
PORT=8080

# JWT Auth
JWT_SECRET=change-me-min-32-chars-secret-key
JWT_EXPIRY=24h

# Integrasi opsional (stub bila kosong)
EMETERAI_BASE_URL=
EMETERAI_API_KEY=
ESIGN_BASE_URL=
ESIGN_API_KEY=
PDF_TEMPLATE_PATH=./templates

# AI Integration (Bazaarlink.ai)
AI_BASE_URL=https://api.bazaarlink.ai/v1
AI_API_KEY=your-bazaarlink-api-key
AI_MODEL=nama-model-anda
