# e-Notary BPRS — Backend Environment Example
# Salin menjadi .env:  cp .env.example .env

# Database PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=bprs_enotary
DB_SSLMODE=disable
# Untuk Vercel/Neon, isi DATABASE_URL di environment Vercel.
DATABASE_URL=

# Server HTTP (Gin)
# Vercel mengisi PORT secara otomatis; nilai ini untuk lokal.
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
PORT=8080

# JWT Auth
JWT_SECRET=change-me-min-32-chars-secret-key
JWT_EXPIRY=24h

# Integrasi opsional (stub bila kosong)
EMETERAI_BASE_URL=
EMETERAI_API_KEY=
ESIGN_BASE_URL=
ESIGN_API_KEY=
PDF_TEMPLATE_PATH=./templates

# CBS/LOS BPRS Tahap 2
CBS_BASE_URL=
CBS_API_KEY=
CBS_CLIENT_CODE=

# BPN Tahap 4
BPN_BASE_URL=
BPN_API_KEY=
BPN_SECRET_KEY=

# Pegadaian Tahap 5 (opsional, hanya bila ada agunan gadai)
PEGADAIAN_BASE_URL=
PEGADAIAN_API_KEY=
PEGADAIAN_PARTNER_CODE=

# Keycloak SSO self-host (compose service keycloak, realm enotary).
# ISSUER = URL publik untuk browser; INTERNAL_URL = URL antar-container untuk backend.
# Contoh lokal: ISSUER=http://localhost:8180/realms/enotary
#   INTERNAL_URL=http://keycloak:8080/realms/enotary (di docker) atau sama dengan ISSUER (lokal).
KEYCLOAK_ISSUER=
KEYCLOAK_INTERNAL_URL=
KEYCLOAK_CLIENT_ID=enotary-backend
KEYCLOAK_CLIENT_SECRET=change-me-backend-secret
KEYCLOAK_REDIRECT_URL=http://localhost:8080/api/v1/auth/sso/callback
FRONTEND_URL=http://localhost:5173

# AI Integration (Bazaarlink.ai)
AI_BASE_URL=https://api.bazaarlink.ai/v1
AI_API_KEY=your-bazaarlink-api-key
AI_MODEL=nama-model-anda
